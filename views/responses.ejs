<!DOCTYPE html>
<html>
<head>
    <title>Ответы: <%= form.title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Ответы на форму: <%= form.title %></h1>
        
        <p><a href="/admin">&larr; Вернуться в управление</a></p>

        <% if (form.responses.length === 0) { %>
            <p>Пока никто не заполнил эту форму.</p>
        <% } else { %>
            <ul>
                <% form.responses.forEach((response, index) => { %>
                    <li>
                        <strong>Ответ №<%= index + 1 %></strong> 
                        <span style="font-size: 12px; color: #888;">(<%= new Date(response.date).toLocaleString() %>)</span>
                        <ul>
                            <% for (let key in response.answers) { %>
                                <li style="border: none; padding: 5px 0;">
                                <% 
                                 const fieldObj = form.fields.find(f => f.id === key);
                                 const label = fieldObj ? fieldObj.label : key; 
                                %>
<b><%= label %>:</b> <%= response.answers[key] %>
                                </li>
                            <% } %>
                        </ul>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>
</body>
</html>